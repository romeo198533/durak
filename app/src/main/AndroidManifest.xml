<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Интернет нужен только для проверки обновления на GitHub. В саму игру
         играют без сети: соперник — программа в этом же телефоне. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Установка скачанного обновления: система спросит подтверждение. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- До Android 10 системная загрузка не кладёт файл в общую папку
         «Загрузки» без этого права. Новее оно не нужно и не выдаётся. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Партия живёт в фоне, пока её смотрят не с экрана, а из другого окна:
         свернул игру или погасил телефон — соперник за столом никуда не делся,
         и связь рвать нельзя. Ради этого поднимается служба переднего плана, а
         ей нужны оба разрешения: одно общее, другое — на связь с устройством,
         то есть на блютус и вай-фай, которыми игра и разговаривает. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Уведомление о партии. Нужно не ради слов в шторке: без него на Android
         13 и новее система не показывает уведомление службы, а сама служба всё
         равно живёт. Спрашивать его отдельно игра не станет — из-за одной
         строчки в шторке устраивать слепому ещё один диалог не стоит. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Вай-фай, которым игра связывает два телефона в одной сети.

         Разрешение не про сам сокет, а про службу переднего плана: на Android
         14 и новее тип «связь с устройством» пускают только тогда, когда игре
         есть чем доказать, что связь настоящая. Достаточно любого одного из
         двух — либо выданного в рантайме блютуса, либо вот этого. Блютус
         спрашивают окном и человек может отказать, а это выдаётся при
         установке молча, поэтому путь вай-фая защищён им: без него партия в
         фоне падала бы с отказом в доступе у того, кто блютусом не пользуется.
         Спрашивать его отдельно у слепого не приходится — окна не будет. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Блютус — для игры вдвоём рядом, без интернета.

         Права здесь не одно, а два поколения сразу. До Android 12 блютус
         разрешался целиком и при установке; начиная с 12 система спрашивает
         отдельно и только на то, что игре правда нужно, — связь со спаренным
         устройством. Поэтому старые права объявлены с пределом: на новых
         версиях они уже ничего не значат, а объявленные без предела мешали бы
         установке.

         Права на поиск незнакомых устройств здесь нет намеренно: телефоны
         спаривают в системных настройках, и игра берёт готовый список. Меньше
         разрешений — меньше окон, которые нужно вслух разбирать слепому. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Блютуса в телефоне может и не быть: игра и без него играется с
         программой, поэтому требуем необязательно. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Без этого блока список установленных синтезаторов речи вернёт один
         движок по умолчанию, и выбор синтезатора в настройках будет пустым.
         Ошибка тихая: на вид просто нет выбора. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <!-- Ссылка на телеграм открывается чужим приложением: без этой строки
             на Android 11 и новее его может не оказаться в поле зрения, и
             кнопка «Написать разработчику» молча ничего не сделает. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Durak">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Партия не должна начинаться заново от поворота телефона: экраны
             собираются кодом, и пересоздание сбрасывало бы раздачу. -->
        <activity
            android:name=".SetupActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".SpeechActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".LookActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- Инструкция: длинный текст, читают и слушают по абзацам. -->
        <activity
            android:name=".HelpActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- Экраны игры вместе: тут связываются и тут же играют. Связь живёт
             не в экране, а в партии, поэтому уход экрана её не рвёт. -->
        <activity
            android:name=".NetActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".NetGameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- Партия в фоне: пока идёт игра, служба держит приложение живым, а в
             шторке видно, что игра идёт, и туда же можно вернуться за стол. -->
        <service
            android:name=".GameService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
